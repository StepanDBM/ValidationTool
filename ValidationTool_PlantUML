@startuml
title Validation Tool - Layered Architecture

top to bottom direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho


'==============================
' UI LAYER
'==============================
package "UI Layer (C# / WPF)" #BBDEFB {

    [ValidationTool.UI] as UI
    [ValidationViewModel] as VM
    [IssueViewModel] as IssueVM

    package "Notifications" #E3F2FD {
        [NotificationService] as Notify
        [SlackService] as Slack
        [DiscordService] as Discord
        [TeamsService] as Teams
        [MessageBuilder] as MsgB
    }

    [JsonLoad] as JSON_L


    package "User Interface" #FFCDD2 {
        [Main View] as MainV
        [Validation View] as ValV
        [Charging Bar / Run Controls] as ChargingBar
        [Profiles View] as ProfilesV
        [Budgets View] as BudgetsV
        [Configuration View] as ConfigV
        [SubViews] as SubViews
        [Scene View] as SceneV
    }

}

'==============================
' EXECUTION LAYER
'==============================
package "Execution Layer (.py)" #C8E6C9 {
    [Validation Runner (Headless)] as Runner
    [DCC Launcher] as DCCRunner
    [Issue Fix runner] as FixRunner
}

'==============================
' DCC LAYER
'==============================
package "DCC Layer (dcc.py)" #FFF9C4 {

    [Headless Extractor\n(DCC Abstraction)] as DCCExtract
    [Headless Fixer\n(DCC Abstraction)] as DCCFix

    package "DCC Hosts" {
        [Maya] as Maya
        [Blender] as Blender
        [Houdini] as Houdini
    }

    [BaseContext] as BC
    [Derived Contexts\n(Mesh / Camera / Light...)] as Contexts

    package "Fix System" #FFCDD2 {
        [Maya Fix] as MayaFix
        [Blender Fix] as BlenderFix
        [Houdini Fix] as HoudiniFix
    }
}

'==============================
' VALIDATION ENGINE
'==============================
package "Validation Engine (.py)" #F8BBD0 {

    [Registry] as Registry
    [CheckDefinition] as CheckDef
    [Checks] as Checks
    [Issue DTO] as IssueDTO
    [Json Save] as JSON_S
}

'==============================
' DATA LAYER
'==============================
package "Data Layer" #ECEFF1 {
    database "JSON Report" {
        [Report File] as JSON
    }

'==============================
' CONFIG / PROFILE LAYER
'==============================
package "Configuration & Profile Layer" #D1C4E9 {

    package "Static Config JSONs" #EDE7F6 {
        [validation_config.json] as ValidationConfigJSON
        [naming_rules.json] as NamingRulesJSON
        [budgets.json] as BudgetsJSON
        [profiles.json] as ProfilesJSON
        [active_profile.json] as ActiveProfileJSON
    }

    package "Python Config DTOs" #EDE7F6 {
        [ValidationConfig] as ValidationConfigDTO
        [NamingRules] as NamingRulesDTO
        [BudgetConfig] as BudgetConfigDTO
        [ProfileConfig] as ProfileConfigDTO
        [AttributeOverride] as AttrOverrideDTO
    }

    package "Profile Runtime System" #D1C4E9 {
        [ConfigLoader] as ConfigLoader
        [EffectiveValidationConfig] as EffectiveConfig
        [Override Resolver] as OverrideResolver
    }
}


}

'==============================
' CONTROL FLOW (TOP → DOWN)
'==============================
UI --> VM
VM --> Runner : run validation
Runner --> DCCRunner : execute headless
DCCRunner --> DCCExtract
Runner --> Checks : register checks

DCCExtract --> Maya
DCCExtract --> Blender
DCCExtract --> Houdini

Maya --> BC
Blender --> BC
Houdini --> BC

BC --> Contexts

Checks --> IssueDTO : create issues
IssueDTO --> JSON_S : serialize
JSON_S --> JSON : save report
VM --> UI

'==============================
' DATA FLOW (BOTTOM → UP)
'==============================
JSON --> JSON_L : load report
JSON_L --> VM

VM --> IssueVM
VM --> Notify

Notify --> Slack
Notify --> Teams
Notify --> Discord

Slack --> MsgB
Teams --> MsgB
Discord --> MsgB

'==============================
' UI STRUCTURE
'==============================
UI --> MainV
MainV --> ValV
ValV --> SubViews

SceneV --> SubViews : open scene

'==============================
' FIX SYSTEM
'==============================
VM --> FixRunner
FixRunner --> DCCRunner
DCCRunner --> DCCFix
DCCFix --> MayaFix
DCCFix --> BlenderFix
DCCFix --> HoudiniFix

MayaFix --> BC
BlenderFix --> BC
HoudiniFix --> BC


'===============================
' Profile Flow
'===============================


ConfigLoader --> ValidationConfigDTO
ConfigLoader --> NamingRulesDTO
ConfigLoader --> BudgetConfigDTO
ConfigLoader --> ProfileConfigDTO


ProfileConfigDTO --> AttrOverrideDTO

Runner --> EffectiveConfig : clone base config
EffectiveConfig --> ValidationConfigDTO
EffectiveConfig --> NamingRulesDTO
EffectiveConfig --> BudgetConfigDTO

Runner --> OverrideResolver : apply active profile overrides
OverrideResolver --> EffectiveConfig : mutate effective runtime config

Checks --> EffectiveConfig : read effective config/budgets/naming
Checks --> Contexts : validate extracted objects
Checks --> IssueDTO : create issues


@enduml