<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="ColorBgMain">#F3F4F6</Color>
    <Color x:Key="ColorBgPanel">#FFFFFF</Color>
    <Color x:Key="ColorBgRowAlt">#E9ECEF</Color>
    <Color x:Key="ColorBgElement">#F8F9FA</Color>

    <Color x:Key="ColorTextDisabled">#9CA3AF</Color>
    <Color x:Key="ColorTextOnAccent">#FFFFFF</Color>
    <Color x:Key="ColorTransparent">#00FFFFFF</Color>

    <Color x:Key="ColorText">#1F2933</Color>
    <Color x:Key="ColorTextMuted">#64748B</Color>

    <Color x:Key="ColorBorder">#CBD5E1</Color>
    <Color x:Key="ColorHover">#E2E8F0</Color>
    <Color x:Key="ColorAccent">#2563EB</Color>

    <Color x:Key="ColorError">#C0392B</Color>
    <Color x:Key="ColorWarning">#B7791F</Color>
    <Color x:Key="ColorInfo">#0E7490</Color>




        <SolidColorBrush x:Key="BrushBgMain"
                     Color="{DynamicResource ColorBgMain}" />

        <SolidColorBrush x:Key="BrushBgPanel"
                     Color="{DynamicResource ColorBgPanel}" />

        <SolidColorBrush x:Key="BrushBgRowAlt"
                     Color="{DynamicResource ColorBgRowAlt}" />

        <SolidColorBrush x:Key="BrushBgElement"
                     Color="{DynamicResource ColorBgElement}" />


        <SolidColorBrush x:Key="BrushTextDisabled"
                 Color="{DynamicResource ColorTextDisabled}" />

        <SolidColorBrush x:Key="BrushTextOnAccent"
                 Color="{DynamicResource ColorTextOnAccent}" />

        <SolidColorBrush x:Key="BrushTransparent"
                 Color="{DynamicResource ColorTransparent}" />


        <SolidColorBrush x:Key="BrushText"
                     Color="{DynamicResource ColorText}" />

        <SolidColorBrush x:Key="BrushTextMuted"
                     Color="{DynamicResource ColorTextMuted}" />

        <SolidColorBrush x:Key="BrushBorder"
                     Color="{DynamicResource ColorBorder}" />

        <SolidColorBrush x:Key="BrushHover"
                     Color="{DynamicResource ColorHover}" />

        <SolidColorBrush x:Key="BrushAccent"
                     Color="{DynamicResource ColorAccent}" />

        <SolidColorBrush x:Key="BrushError"
                     Color="{DynamicResource ColorError}" />

        <SolidColorBrush x:Key="BrushWarning"
                     Color="{DynamicResource ColorWarning}" />

        <SolidColorBrush x:Key="BrushInfo"
                     Color="{DynamicResource ColorInfo}" />

        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"
                     Color="{DynamicResource ColorBgPanel}" />

        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}"
                     Color="{DynamicResource ColorText}" />


</ResourceDictionary>