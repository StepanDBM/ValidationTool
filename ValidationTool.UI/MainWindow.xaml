<Window x:Class="ValidationTool.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ValidationTool.UI"
        xmlns:views="clr-namespace:ValidationTool.UI.Views"
        xmlns:controls="clr-namespace:ValidationTool.UI.Views.ValidationView_Controls"
        mc:Ignorable="d"
        Title="ValidationTool - by Styopa DBM" Height="650" Width="800"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BrushBgMain}">


    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <!-- Custom title bar -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border Grid.Row="0"
            Background="{StaticResource BrushBgPanel}"
            MouseDown="TitleBar_MouseDown">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <TextBlock Text="ValidationTool"
                       VerticalAlignment="Center"
                       Margin="10,0"
                       Foreground="{StaticResource BrushText}" />

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" Grid.Column="1">

                    <Button Content="_"
                        Width="40"
                        Click="Minimize_Click"/>

                    <Button Content="□"
                        Width="40"
                        Click="Maximize_Click"/>

                    <Button Content="X"
                        Width="40"
                        Click="Close_Click"/>

                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">


            <TabControl>

                <TabItem Header="Validation">
                    <views:ValidationView/>
                </TabItem>

                <TabItem Header="Budgets">
                    <views:UC_BudgetsMain/>
                </TabItem>

                <TabItem Header="Configuration">
                    <views:ConfigurationView/>
                </TabItem>

                <TabItem Header="Profiles">
                    <views:ProfilesView/>
                </TabItem>

                <TabItem Header="Stages">
                    <views:StagesView/>
                </TabItem>

            </TabControl>
        </Grid>

    </Grid>

</Window>