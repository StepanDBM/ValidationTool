<Window x:Class="ValidationTool.UI.MainWindow" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ValidationTool.UI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Content="Run Validation"
                Click="Run_Click"
                Height="35"
                Width="150"
                HorizontalAlignment="Left"/>

        <ListView Grid.Row="1"
                    ItemsSource="{Binding Issues}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Asset" DisplayMemberBinding="{Binding AssetName}" />
                    <GridViewColumn Header="Check" DisplayMemberBinding="{Binding CheckName}" />
                    <GridViewColumn Header="Severity" DisplayMemberBinding="{Binding Severity}" />
                    <GridViewColumn Header="Message" DisplayMemberBinding="{Binding Message}" />
                    <GridViewColumn Header="Suggestion" DisplayMemberBinding="{Binding Suggestion}" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
