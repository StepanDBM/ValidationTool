<Window x:Class="ValidationTool.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ValidationTool.UI"
        xmlns:views="clr-namespace:ValidationTool.UI.Views"
        xmlns:controls="clr-namespace:ValidationTool.UI.Views.ValidationView_Controls"
        mc:Ignorable="d"
        Title="ValidationTool - by Styopa DBM" Height="650" Width="1000"
        WindowStyle="None"
        ResizeMode="CanResize">


    <Grid Background="{DynamicResource BrushBgMain}">

        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <views:UC_TopBar Grid.Row="0"
                 TitleText="ValidationTool by Stepan D. Batllori Martinez"/>

        <Grid Grid.Row="1">


            <TabControl>

                <TabItem Header="Validation">
                    <views:ValidationView DataContext="{Binding ValidationVM}"/>
                </TabItem>

                <TabItem Header="Stats">
                    <views:StatsView DataContext="{Binding StatsVM}"/>
                </TabItem>

                <TabItem Header="Budgets">
                    <views:UC_BudgetsMain/>
                </TabItem>

                <TabItem Header="Configuration">
                    <views:ConfigurationView/>
                </TabItem>

                <TabItem Header="Profiles">
                    <views:ProfilesView/>
                </TabItem>
                <!--
                <TabItem Header="Stages">
                    <views:StagesView/>
                </TabItem>
                -->
            </TabControl>
        </Grid>

    </Grid>

</Window>