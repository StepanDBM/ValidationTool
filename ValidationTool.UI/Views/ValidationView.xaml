<UserControl x:Class="ValidationTool.UI.Views.ValidationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Content="Load Report"
                Click="loadReportUI"
                Width="150"
                Height="35"/>

        <ListView Grid.Row="1"
                  ItemsSource="{Binding Issues}">

            <ListView.View>

                <GridView>

                    <GridViewColumn Header="Asset"
                                    DisplayMemberBinding="{Binding AssetName}" />

                    <GridViewColumn Header="Check"
                                    DisplayMemberBinding="{Binding CheckName}" />

                    <GridViewColumn Header="Severity"
                                    DisplayMemberBinding="{Binding Severity}" />

                    <GridViewColumn Header="Message"
                                    DisplayMemberBinding="{Binding Message}" />

                </GridView>

            </ListView.View>

        </ListView>

    </Grid>

</UserControl>