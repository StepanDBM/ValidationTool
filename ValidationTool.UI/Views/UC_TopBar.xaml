<UserControl x:Class="ValidationTool.UI.Views.UC_TopBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="25">

    <Border Background="{DynamicResource BrushBgPanel}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="0,0,0,1"
            MouseDown="TitleBar_MouseDown">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding TitleText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       VerticalAlignment="Center"
                       Margin="10,0"
                       Foreground="{DynamicResource BrushText}"
                       FontWeight="SemiBold"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">

                <Button Content="☀"
                        Width="70"
                        Click="ToggleTheme_Click"/>

                <Button Content="_"
                        Width="40"
                        Click="Minimize_Click"/>

                <Button Content="□"
                        Width="40"
                        Click="Maximize_Click"/>

                <Button Content="X"
                        Width="40"
                        Click="Close_Click"/>

            </StackPanel>
        </Grid>
    </Border>
</UserControl> 