<UserControl x:Class="ValidationTool.UI.Views.StatsView_Controls.UC_ArtistSupportSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{StaticResource BrushBgPanel}"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="ARTIST SUPPORT SUMMARY"
                       FontSize="15"
                       FontWeight="Bold"
                       Opacity="0.9"/>

            <TextBlock Grid.Row="2"
                       Text="{Binding Subtitle}"
                       FontSize="11"
                       Opacity="0.65"/>

            <ScrollViewer Grid.Row="4"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BrushBgElement}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8"
                                    Margin="0,0,0,10">

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Artist}"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Artist}"/>

                                            <TextBlock Text="{Binding Team}"
                                                       FontSize="11"
                                                       Opacity="0.65"
                                                       Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Team}"/>
                                        </StackPanel>

                                        <Border Grid.Column="1"
                                                Background="{StaticResource BrushBgPanel}"
                                                BorderBrush="{StaticResource BrushBorder}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="6,3"
                                                VerticalAlignment="Center">

                                            <TextBlock Text="{Binding SupportLevel}"
                                                       FontWeight="Bold"
                                                       FontSize="12"/>
                                        </Border>
                                    </Grid>

                                    <ProgressBar Grid.Row="2"
                                                 Height="16"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding BarPercent}"
                                                 Background="{StaticResource BrushBgPanel}"
                                                 Foreground="{StaticResource BrushAccent}"
                                                 BorderBrush="{StaticResource BrushBorder}"
                                                 BorderThickness="1"/>

                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Opacity="0.75">
                                                <Run Text="Errors: "/>
                                                <Run Text="{Binding ErrorsDisplay}"/>
                                                <Run Text="  |  Warnings: "/>
                                                <Run Text="{Binding WarningsDisplay}"/>
                                            </TextBlock>

                                            <TextBlock Opacity="0.75"
                                                       Margin="0,3,0,0">
                                                <Run Text="Files: "/>
                                                <Run Text="{Binding FileCountDisplay}"/>
                                                <Run Text="  |  Issues: "/>
                                                <Run Text="{Binding TotalIssuesDisplay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    HorizontalAlignment="Right">

                                            <TextBlock Opacity="0.75"
                                                       HorizontalAlignment="Right">
                                                <Run Text="Avg Issues/File: "/>
                                                <Run Text="{Binding AverageIssuesPerFileDisplay}"/>
                                            </TextBlock>

                                            <TextBlock Opacity="0.75"
                                                       Margin="0,3,0,0"
                                                       HorizontalAlignment="Right">
                                                <Run Text="Avg Errors/File: "/>
                                                <Run Text="{Binding AverageErrorsPerFileDisplay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    Orientation="Horizontal">

                                            <TextBlock Opacity="0.65">
                                                <Run Text="Top Stage: "/>
                                                <Run Text="{Binding TopStage}"/>
                                            </TextBlock>

                                            <TextBlock Text="  |  "
                                                       Opacity="0.45"/>

                                            <TextBlock Opacity="0.65"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding TopCheck}">
                                                <Run Text="Top Check: "/>
                                                <Run Text="{Binding TopCheck}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   HorizontalAlignment="Right"
                                                   Opacity="0.65">
                                            <Run Text="Score: "/>
                                            <Run Text="{Binding SeverityScoreDisplay}"/>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>