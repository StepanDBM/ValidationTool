<UserControl x:Class="ValidationTool.UI.Views.StatsView_Controls.UC_StatsKpiStripView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource BrushBgPanel}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <StackPanel>
                <TextBlock Text="TOTAL ISSUES"
                           FontWeight="Bold"
                           Opacity="0.75"/>

                <TextBlock Text="{Binding TotalIssues}"
                           FontSize="26"
                           FontWeight="Bold"
                           Margin="0,6,0,0"/>

                <TextBlock Text="all loaded"
                           Opacity="0.65"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="2"
                Background="{DynamicResource BrushBgPanel}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <StackPanel>
                <TextBlock Text="ERRORS"
                           FontWeight="Bold"
                           Opacity="0.75"/>

                <TextBlock Text="{Binding Errors}"
                           FontSize="26"
                           FontWeight="Bold"
                           Margin="0,6,0,0"/>

                <TextBlock Text="blockers"
                           Opacity="0.65"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="4"
                Background="{DynamicResource BrushBgPanel}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <StackPanel>
                <TextBlock Text="WARNINGS"
                           FontWeight="Bold"
                           Opacity="0.75"/>

                <TextBlock Text="{Binding Warnings}"
                           FontSize="26"
                           FontWeight="Bold"
                           Margin="0,6,0,0"/>

                <TextBlock Text="needs review"
                           Opacity="0.65"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="6"
                Background="{DynamicResource BrushBgPanel}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <StackPanel>
                <TextBlock Text="FILES"
                           FontWeight="Bold"
                           Opacity="0.75"/>

                <TextBlock Text="{Binding Files}"
                           FontSize="26"
                           FontWeight="Bold"
                           Margin="0,6,0,0"/>

                <TextBlock Text="scenes/files"
                           Opacity="0.65"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="8"
                Background="{DynamicResource BrushBgPanel}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <StackPanel>
                <TextBlock Text="AUTO-FIXABLE"
                           FontWeight="Bold"
                           Opacity="0.75"/>

                <TextBlock Text="{Binding AutoFixablePercent, StringFormat={}{0:0.0}%}"
                           FontSize="26"
                           FontWeight="Bold"
                           Margin="0,6,0,0"/>

                <TextBlock Text="possible wins"
                           Opacity="0.65"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="10"
                Background="{DynamicResource BrushBgPanel}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <StackPanel>
                <TextBlock Text="HEALTH SCORE"
                           FontWeight="Bold"
                           Opacity="0.75"/>

                <TextBlock Text="{Binding HealthScore, StringFormat={}{0} / 100}"
                           FontSize="26"
                           FontWeight="Bold"
                           Margin="0,6,0,0"/>

                <TextBlock Text="production"
                           Opacity="0.65"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>