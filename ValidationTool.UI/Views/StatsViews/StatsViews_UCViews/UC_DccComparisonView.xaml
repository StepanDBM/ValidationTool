<UserControl x:Class="ValidationTool.UI.Views.StatsView_Controls.UC_DccComparisonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{StaticResource BrushBgPanel}"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12">

        <Grid>
            <TextBlock Text="DCC Comparison&#x0a;&#x0a;Horizontal comparison of Maya / Blender / Houdini issue counts and average errors per file."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
        </Grid>
    </Border>
</UserControl>