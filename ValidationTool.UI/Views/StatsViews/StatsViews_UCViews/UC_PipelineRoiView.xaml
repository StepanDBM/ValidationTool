<UserControl x:Class="ValidationTool.UI.Views.StatsView_Controls.UC_PipelineRoiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{DynamicResource BrushBgPanel}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="PIPELINE ROI"
                       FontSize="15"
                       FontWeight="Bold"
                       Opacity="0.9"/>

            <TextBlock Grid.Row="2"
                       Text="{Binding Subtitle}"
                       FontSize="11"
                       Opacity="0.65"
                       TextWrapping="Wrap"/>

            <Border Grid.Row="4"
                    Background="{DynamicResource BrushBgElement}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Estimated Hours Saved"
                                   FontWeight="Bold"
                                   Opacity="0.75"/>

                        <TextBlock Text="{Binding EstimatedSavedHoursDisplay}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Margin="0,6,0,0"/>

                        <TextBlock Text="{Binding EstimatedSavedMinutesDisplay}"
                                   Opacity="0.65"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Best Auto-Fix Domain"
                                   FontWeight="Bold"
                                   Opacity="0.75"/>

                        <TextBlock Text="{Binding BestAutoFixDomain}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,6,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding BestAutoFixDomain}"/>

                        <TextBlock Opacity="0.65"
                                   Margin="0,2,0,0">
                            <Run Text="Auto-fixable issues: "/>
                            <Run Text="{Binding BestAutoFixDomainCountDisplay}"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="6"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel>

                    <Border Background="{DynamicResource BrushBgElement}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8"
                            Margin="0,0,0,8">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Auto"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>

                            <ProgressBar Grid.Column="1"
                                         Height="14"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding AutoBarPercent}"
                                         Background="{DynamicResource BrushBgPanel}"
                                         Foreground="{DynamicResource BrushAccent}"
                                         BorderBrush="{DynamicResource BrushBorder}"
                                         BorderThickness="1"
                                         Margin="8,0"/>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding AutoFixableIssuesDisplay}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource BrushBgElement}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8"
                            Margin="0,0,0,8">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Semi"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>

                            <ProgressBar Grid.Column="1"
                                         Height="14"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding SemiBarPercent}"
                                         Background="{DynamicResource BrushBgPanel}"
                                         Foreground="{DynamicResource BrushInfo}"
                                         BorderBrush="{DynamicResource BrushBorder}"
                                         BorderThickness="1"
                                         Margin="8,0"/>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding SemiFixableIssuesDisplay}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource BrushBgElement}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8"
                            Margin="0,0,0,8">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Manual"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>

                            <ProgressBar Grid.Column="1"
                                         Height="14"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding ManualBarPercent}"
                                         Background="{DynamicResource BrushBgPanel}"
                                         Foreground="{DynamicResource BrushWarning}"
                                         BorderBrush="{DynamicResource BrushBorder}"
                                         BorderThickness="1"
                                         Margin="8,0"/>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding ManualOnlyIssuesDisplay}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource BrushBgElement}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="None"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>

                            <ProgressBar Grid.Column="1"
                                         Height="14"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding NoneBarPercent}"
                                         Background="{DynamicResource BrushBgPanel}"
                                         Foreground="{DynamicResource BrushBorder}"
                                         BorderBrush="{DynamicResource BrushBorder}"
                                         BorderThickness="1"
                                         Margin="8,0"/>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding NoFixIssuesDisplay}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       FontWeight="Bold"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
