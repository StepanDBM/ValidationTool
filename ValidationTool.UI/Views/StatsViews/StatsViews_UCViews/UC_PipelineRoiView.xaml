<UserControl x:Class="ValidationTool.UI.Views.StatsView_Controls.UC_PipelineRoiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{StaticResource BrushBgPanel}"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12">

        <Grid>
            <TextBlock Text="Pipeline ROI&#x0a;&#x0a;Estimated saved time, auto-fixable issue count, semi-fixable issues, and best automation domains."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
        </Grid>
    </Border>
</UserControl>