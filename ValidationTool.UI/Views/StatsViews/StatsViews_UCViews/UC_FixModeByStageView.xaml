<UserControl x:Class="ValidationTool.UI.Views.StatsView_Controls.UC_FixModeByStageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{DynamicResource BrushBgPanel}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="FIX MODE BY STAGE"
                       FontSize="15"
                       FontWeight="Bold"
                       Opacity="0.9"/>

            <TextBlock Grid.Row="2"
                       Text="{Binding Subtitle}"
                       FontSize="11"
                       Opacity="0.65"/>

            <ScrollViewer Grid.Row="4"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BrushBgElement}"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8"
                                    Margin="0,0,0,10">

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Stage}"
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Stage}"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TotalDisplay}"
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>

                                    <ProgressBar Grid.Row="2"
                                                 Height="14"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding StageBarPercent}"
                                                 Background="{DynamicResource BrushBgPanel}"
                                                 Foreground="{DynamicResource BrushAccent}"
                                                 BorderBrush="{DynamicResource BrushBorder}"
                                                 BorderThickness="1"/>

                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Auto"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.8"/>

                                        <ProgressBar Grid.Column="1"
                                                     Height="12"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding AutoPercent}"
                                                     Background="{DynamicResource BrushBgPanel}"
                                                     Foreground="{DynamicResource BrushAccent}"
                                                     BorderBrush="{DynamicResource BrushBorder}"
                                                     BorderThickness="1"
                                                     Margin="6,0"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding AutoDisplay}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding AutoPercentDisplay}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Opacity="0.65"/>
                                    </Grid>

                                    <Grid Grid.Row="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Semi"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.8"/>

                                        <ProgressBar Grid.Column="1"
                                                     Height="12"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding SemiPercent}"
                                                     Background="{DynamicResource BrushBgPanel}"
                                                     Foreground="{DynamicResource BrushInfo}"
                                                     BorderBrush="{DynamicResource BrushBorder}"
                                                     BorderThickness="1"
                                                     Margin="6,0"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding SemiDisplay}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding SemiPercentDisplay}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Opacity="0.65"/>
                                    </Grid>

                                    <Grid Grid.Row="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Manual"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.8"/>

                                        <ProgressBar Grid.Column="1"
                                                     Height="12"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding ManualPercent}"
                                                     Background="{DynamicResource BrushBgPanel}"
                                                     Foreground="{DynamicResource BrushWarning}"
                                                     BorderBrush="{DynamicResource BrushBorder}"
                                                     BorderThickness="1"
                                                     Margin="6,0"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ManualDisplay}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding ManualPercentDisplay}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Opacity="0.65"/>
                                    </Grid>

                                    <Grid Grid.Row="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="None"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.8"/>

                                        <ProgressBar Grid.Column="1"
                                                     Height="12"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding NonePercent}"
                                                     Background="{DynamicResource BrushBgPanel}"
                                                     Foreground="{DynamicResource BrushBorder}"
                                                     BorderBrush="{DynamicResource BrushBorder}"
                                                     BorderThickness="1"
                                                     Margin="6,0"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding NoneDisplay}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding NonePercentDisplay}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Opacity="0.65"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>