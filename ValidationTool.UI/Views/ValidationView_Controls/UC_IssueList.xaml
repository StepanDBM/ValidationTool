<UserControl x:Class="ValidationTool.UI.Views.ValidationView_Controls.UC_IssueList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <DataGrid ItemsSource="{Binding IssuesView}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="*" />
                <DataGridTextColumn Header="Asset" Binding="{Binding Asset_name}" Width="*" />
                <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="*" />
                <DataGridTextColumn Header="Check" Binding="{Binding Check_name}" Width="*" />
                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="*" />
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2*" />
                <DataGridTextColumn Header="Suggestion" Binding="{Binding Suggestion}" Width="2*" />

                <DataGridTemplateColumn Header="Fix" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding FixButtonText}"
                                    ToolTip="{Binding FixTooltip}"
                                    Visibility="{Binding ShowFixButton, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Command="{Binding DataContext.FixIssueCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"/> 
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Report" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding ReportButtonText}"
                                    ToolTip="{Binding ReportToolTip}"
                                    Command="{Binding DataContext.SendReportCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>