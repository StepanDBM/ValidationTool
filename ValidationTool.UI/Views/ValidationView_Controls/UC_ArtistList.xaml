<UserControl x:Class="ValidationTool.UI.Views.ValidationView_Controls.UC_ArtistList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="300">
    <Grid>
        <Label Grid.Row="0" 
           Content="Team" FontSize="30"
           Margin="15 15 15 15" />
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding ArtistList}"
                  SelectedItem="{Binding SelectedArtistVM, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Artist"
                            Binding="{Binding ArtistName}"
                            Width="*" />

                <DataGridTextColumn Header="Gmail"
                            Binding="{Binding ArtistGmail}"
                            Width="2*" />

                <DataGridTextColumn Header="Seniority"
                            Binding="{Binding ArtistLv}"
                            Width="*" />

                <DataGridTextColumn Header="ID"
                            Binding="{Binding ArtistID}"
                            Width="*" />

                <DataGridTextColumn Header="Issues"
                            Binding="{Binding Issues}"
                            Width="*" />

                <DataGridTextColumn Header="Warnings"
                            Binding="{Binding Warnings}"
                            Width="*" />

                <DataGridTextColumn Header="Errors"
                            Binding="{Binding Errors}"
                            Width="*" />
                <DataGridTemplateColumn Header="Report" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Report"
                                    Command="{Binding DataContext.SendReportCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>

        </DataGrid>
    </Grid>
</UserControl>
