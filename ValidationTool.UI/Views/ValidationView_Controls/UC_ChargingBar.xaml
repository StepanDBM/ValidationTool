<UserControl x:Class="ValidationTool.UI.Views.ValidationView_Controls.UC_ChargingBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="10"
          Background="{StaticResource BrushBgPanel}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Buttons -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">

            <Button Content="Run Maya"
                    Width="120"
                    Height="35"
                    Margin="5"
                    Click="RunMaya_Click"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <Button Content="Run Blender"
                    Width="120"
                    Height="35"
                    Margin="5"
                    Click="RunBlender_Click"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <Button Content="Load Report"
                    Width="120"
                    Height="35"
                    Margin="5"
                    Click="LoadReport_Click"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <Button Content="Load Proxy"
                    Width="120"
                    Height="35"
                    Margin="5"
                    Click="LoadProxy_Click"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>

        <!-- Current file -->
        <ListBox x:Name="LogList"
                 Grid.Row="1"
                 ItemsSource="{Binding LogLines}"
                 Background="{StaticResource BrushBgElement}"
                 Foreground="{StaticResource BrushText}"
                 FontFamily="Consolas"
                 FontSize="12"
                 Margin="5"
                 Height="200"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>

        <!-- Progress -->
        <Grid Grid.Row="2">
            <ProgressBar Height="25"
                         Margin="5"
                         Minimum="0"
                         Maximum="100"
                         Width="Auto"
                         
                         Background="{StaticResource BrushBgElement}"
                         Foreground="{StaticResource BrushAccent}"

                         Value="{Binding Progress}"/>

            <TextBlock Text="{Binding Progress}"
                       Foreground="White"
                       Background="Transparent"
                       VerticalAlignment="Center"
                       Margin="20,0,0,0"/>
        </Grid>

        <!-- Summary -->
        <TextBlock Grid.Row="3" Margin="5">
            <TextBlock.Text>
                <MultiBinding StringFormat="[Issues: {0} | Errors: {1} | Warnings: {2}] in: {3} ObjectContexts from {4} Scenes">
                    <Binding Path="TotalIssues"/>
                    <Binding Path="TotalErrors"/>
                    <Binding Path="TotalWarnings"/>
                    <Binding Path="TotalAssets"/>
                    <Binding Path="TotalScenes"/>
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>

    </Grid>
</UserControl>
