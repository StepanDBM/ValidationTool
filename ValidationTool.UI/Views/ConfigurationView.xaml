<UserControl x:Class="ValidationTool.UI.Views.ConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="10">

            
            <StackPanel Orientation="Horizontal">

                <Button Content="Load"
                        Command="{Binding LoadCommand}"
                        Width="100" />

                <Button Content="Save"
                        Command="{Binding SaveCommand}"
                        Width="100"
                        Margin="10,0,0,0"/>

            </StackPanel>

            
            <TextBlock Text="Global Settings"
                       FontWeight="Bold"
                       Margin="0,10,0,5"/>

            <CheckBox Content="Strict Mode"
                      IsChecked="{Binding Config.StrictMode}" />

            <CheckBox Content="Fail on First Error"
                      IsChecked="{Binding Config.FailOnFirstError}" />

            <CheckBox Content="Auto Fix"
                      IsChecked="{Binding Config.AutoFixEnabled}" />

            <CheckBox Content="Include Information"
                      IsChecked="{Binding Config.IncludeInfo}" />

            <CheckBox Content="Include Warnings"
                      IsChecked="{Binding Config.IncludeWarnings}" />

            <CheckBox Content="Debug Mode"
                      IsChecked="{Binding Config.DebugMode}" />



            
            <TextBlock Text="Naming Rules"
                       FontWeight="Bold"
                       Margin="0,20,0,5"/>
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="Load"
                        Command="{Binding LoadNamingRules}"
                        Width="100"/>

                    <Button Content="Save"
                        Command="{Binding SaveNamingRules}"
                        Width="100"
                        Margin="10,0,0,0"/>
                </StackPanel>

                <GroupBox Header="Name Pattern (Regex)" Grid.Row="1" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBox Text="{Binding NamingConfig.NamePattern}"
                             Height="25"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Valid Prefixes (comma-separated)" Grid.Row="2" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBox Text="{Binding ValidPrefixesText}"
                             Height="25"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Default Maya Names (comma-separated)" Grid.Row="3">
                    <StackPanel>
                        <TextBox Text="{Binding DefaultMayaNamesText}"
                             Height="25"/>
                    </StackPanel>
                </GroupBox>

            </Grid>


        </StackPanel>

    </ScrollViewer>

</UserControl>