<UserControl x:Class="ValidationTool.UI.Views.SceneSetupView_Controls.UC_RenderLayers"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <DataGrid ItemsSource="{Binding RenderLayers}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="*"/>
                <DataGridCheckBoxColumn Header="Renderable" Binding="{Binding Renderable}" Width="*"/>
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="*"/>
                <DataGridTextColumn Header="Camera Override" Binding="{Binding CameraOverride}" Width="*"/>
                <DataGridTextColumn Header="Members" Binding="{Binding MemberCount}" Width="*"/>
                <DataGridCheckBoxColumn Header="Valid Name" Binding="{Binding HasValidName}" Width="*"/>
                <DataGridCheckBoxColumn Header="Required" Binding="{Binding IsRequired}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>