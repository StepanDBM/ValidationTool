<UserControl x:Class="ValidationTool.UI.Views.SceneSetupView_Controls.UC_CameraSetup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Camera Setup"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <TextBlock Text="{Binding CameraSetup.ActiveRenderCamera, StringFormat=Active Render Camera: {0}}" Margin="0,3"/>
            <TextBlock Text="{Binding CameraSetup.HasDuplicateRenderCameras, StringFormat=Has Duplicate Render Cameras: {0}}" Margin="0,3"/>
            <TextBlock Text="{Binding CameraSetup.HasNoRenderCamera, StringFormat=Has No Render Camera: {0}}" Margin="0,3"/>
            <TextBlock Text="{Binding CameraSetup.ExpectedShotCamera, StringFormat=Expected Shot Camera: {0}}" Margin="0,3"/>
            <TextBlock Text="{Binding CameraSetup.UsesDefaultRenderCamera, StringFormat=Uses Default Render Camera: {0}}" Margin="0,3"/>

            <TextBlock Text="Renderable Cameras"
                       FontWeight="Bold"
                       Margin="0,15,0,5"/>

            <ItemsControl ItemsSource="{Binding CameraSetup.RenderableCameras}" />

            <TextBlock Text="Default Cameras Present"
                       FontWeight="Bold"
                       Margin="0,15,0,5"/>

            <ItemsControl ItemsSource="{Binding CameraSetup.DefaultCamerasPresent}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>