<Window x:Class="ValidationTool.UI.Views.ProfileOverridePickerWndw"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:topViews="clr-namespace:ValidationTool.UI.Views"
        xmlns:vm="clr-namespace:ValidationTool.UI.ViewModels.ProfilesView_Models"
        Width="620"
        Height="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource BrushBgMain}">

    <Grid Margin="10 0 10 10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <topViews:UC_TopBar Grid.Row="0"
         TitleText="Override Creation Setup"/>

        <!-- Header -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Create Override"
                       FontSize="18"
                       FontWeight="Bold"/>

            <TextBlock Text="Select a known config path and provide a value. The final override path is generated automatically."
                       Opacity="0.75"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Body -->
        <Border Grid.Row="3"
                Background="{StaticResource BrushBgPanel}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Root -->
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Config Root"
                           VerticalAlignment="Center"/>

                <ComboBox Grid.Row="0"
                          Grid.Column="1"
                          ItemsSource="{Binding RootOptions}"
                          SelectedItem="{Binding SelectedRoot, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"/>

                <!-- Section -->
                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Section"
                           VerticalAlignment="Center"/>

                <ComboBox Grid.Row="2"
                          Grid.Column="1"
                          ItemsSource="{Binding SectionOptions}"
                          SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"/>

                <!-- Attribute -->
                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Text="Attribute"
                           VerticalAlignment="Center"/>

                <ComboBox Grid.Row="4"
                          Grid.Column="1"
                          ItemsSource="{Binding AttributeOptions}"
                          SelectedItem="{Binding SelectedAttribute, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"/>

                <!-- Generated path -->
                <TextBlock Grid.Row="6"
                           Grid.Column="0"
                           Text="Generated Path"
                           VerticalAlignment="Center"/>

                <TextBox Grid.Row="6"
                         Grid.Column="1"
                         Text="{Binding GeneratedPath, Mode=OneWay}"
                         IsReadOnly="True"
                         ToolTip="{Binding GeneratedPath, Mode=OneWay}"/>

                <!-- Value -->
                <TextBlock Grid.Row="8"
                           Grid.Column="0"
                           Text="Value"
                           VerticalAlignment="Center"/>

                <Grid Grid.Row="8"
                      Grid.Column="1">

                    <!-- Normal value input -->
                    <TextBox Text="{Binding ValueRaw, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBooleanValue, Mode=OneWay}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Boolean value input -->
                    <ComboBox ItemsSource="{Binding BooleanValues}"
                              SelectedItem="{Binding BoolValueRaw, Mode=TwoWay}">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBooleanValue, Mode=OneWay}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                </Grid>

                <!-- Metadata / expected type / enabled -->
                <Border Grid.Row="10"
                        Grid.ColumnSpan="2"
                        Background="{StaticResource BrushBgElement}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{Binding HelpText, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Opacity="0.85"/>

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal">
                            <TextBlock Text="Expected Type: "/>
                            <TextBlock Text="{Binding ExpectedType, Mode=OneWay}"/>
                        </StackPanel>

                        <CheckBox Grid.Row="4"
                                  Content="Enabled"
                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding ErrorMessage, Mode=OneWay}"
                       Foreground="OrangeRed"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,10,0"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Cancel"
                        Width="90"
                        Margin="0,0,8,0"
                        Click="Cancel_Click"/>

                <Button Content="Confirm"
                        Width="90"
                        Click="Confirm_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>