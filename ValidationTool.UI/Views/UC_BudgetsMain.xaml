<UserControl x:Class="ValidationTool.UI.Views.UC_BudgetsMain"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ValidationTool.UI.ViewModels.BudgetsView_Models"
             xmlns:view="clr-namespace:ValidationTool.UI.Views.BudgetsViews">

    <UserControl.Resources>

        <!-- DataTemplates: VM -> View -->
        <DataTemplate DataType="{x:Type vm:GeometryBudgetsViewModel}">
            <view:UC_BudgetsGeometry />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:UvBudgetsViewModel}">
            <view:UC_BudgetsUv />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MaterialBudgetsViewModel}">
            <view:UC_BudgetsMaterials />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TextureBudgetsViewModel}">
            <view:UC_BudgetsTextures />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RiggingBudgetsViewModel}">
            <view:UC_BudgetsRigging />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AnimationBudgetsViewModel}">
            <view:UC_BudgetsAnimation />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LightingBudgetsViewModel}">
            <view:UC_BudgetsLighting />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CameraBudgetsViewModel}">
            <view:UC_BudgetsCamera />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RenderBudgetsViewModel}">
            <view:UC_BudgetsRender />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:OutputBudgetsViewModel}">
            <view:UC_BudgetsOutput />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ColorManagementBudgetsViewModel}">
            <view:UC_BudgetsColorManagement />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SceneHygieneBudgetsViewModel}">
            <view:UC_BudgetsSceneHygiene />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ExportBudgetsViewModel}">
            <view:UC_BudgetsExport />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PerformanceBudgetsViewModel}">
            <view:UC_BudgetsPerformance />
        </DataTemplate>

    </UserControl.Resources>


    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"
                       DockPanel.Dock="Left"/>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Load"
                        Width="90"
                        Margin="0,0,8,0"
                        Command="{Binding LoadCommand}"/>

                <Button Content="Save"
                        Width="90"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </DockPanel>

        
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource BrushBgPanel}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">

                <DockPanel>
                    <TextBlock Text="Budget Categories"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,10"
                               DockPanel.Dock="Top"/>

                    <ListBox ItemsSource="{Binding Sections}"
                             SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                             DisplayMemberPath="DisplayName"
                             BorderThickness="0"
                             Background="Transparent"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{DynamicResource BrushBgPanel}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">

                <ContentControl Content="{Binding CurrentSectionViewModel}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>