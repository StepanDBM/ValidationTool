<UserControl x:Class="ValidationTool.UI.Views.BudgetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            
            <RowDefinition Height="Auto"/>
            
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        
        <Button Content="Load"
                Click="Load_Click"
                Width="120"/>

        <Button Content="Save"
                Click="Save_Click"
                Width="120"
                Grid.Column="1"/>

        
        <TextBlock Grid.Row="1" Grid.Column="1"
                   Text="Max_V"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="1" Grid.Column="2"
                   Text="Max_T"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="1" Grid.Column="3"
                   Text="Max_Mat_Slot"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>

        
        <TextBlock Text="Static Mesh" Grid.Row="2" Grid.Column="0"/>

        <TextBox Grid.Row="2" Grid.Column="1"
         Text="{Binding Config.StaticMesh.MaxVertices,
                Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}" />

        <TextBox Grid.Row="2" Grid.Column="2"
         Text="{Binding Config.StaticMesh.MaxTriangles,
                Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}" />

        <TextBox Grid.Row="2" Grid.Column="3"
         Text="{Binding Config.StaticMesh.MaxMaterialSlots,
                Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}" />

        
        <TextBlock Text="Character" Grid.Row="3" Grid.Column="0"/>

        <TextBox Grid.Row="3" Grid.Column="1"
         Text="{Binding Config.Character.MaxVertices,
                Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}" />

        <TextBox Grid.Row="3" Grid.Column="2"
         Text="{Binding Config.Character.MaxTriangles,
                Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}" />

        <TextBox Grid.Row="3" Grid.Column="3"
         Text="{Binding Config.Character.MaxMaterialSlots,
                Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}" />

        
        <TextBlock Text="Weapon" Grid.Row="4" Grid.Column="0"/>

        <TextBox Grid.Row="4" Grid.Column="1"
         Text="{Binding Config.Weapon.MaxVertices,
                Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}" />

        <TextBox Grid.Row="4" Grid.Column="2"
         Text="{Binding Config.Weapon.MaxTriangles,
                Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}" />

        <TextBox Grid.Row="4" Grid.Column="3"
         Text="{Binding Config.Weapon.MaxMaterialSlots,
                Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}" />

        
        <TextBlock Text="Prop" Grid.Row="5" Grid.Column="0"/>

        <TextBox Grid.Row="5" Grid.Column="1"
         Text="{Binding Config.Prop.MaxVertices,
                Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}" />

        <TextBox Grid.Row="5" Grid.Column="2"
         Text="{Binding Config.Prop.MaxTriangles,
                Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}" />

        <TextBox Grid.Row="5" Grid.Column="3"
         Text="{Binding Config.Prop.MaxMaterialSlots,
                Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}" />

        
        <TextBlock Text="Environment" Grid.Row="6" Grid.Column="0"/>

        <TextBox Grid.Row="6" Grid.Column="1"
         Text="{Binding Config.Environment.MaxVertices,
                Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}" />

        <TextBox Grid.Row="6" Grid.Column="2"
         Text="{Binding Config.Environment.MaxTriangles,
                Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}" />

        <TextBox Grid.Row="6" Grid.Column="3"
         Text="{Binding Config.Environment.MaxMaterialSlots,
                Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}" />

    </Grid>

</UserControl>