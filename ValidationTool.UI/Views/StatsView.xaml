<UserControl x:Class="ValidationTool.UI.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:stats="clr-namespace:ValidationTool.UI.Views.StatsView_Controls">

    <UserControl.Resources>

        <Style x:Key="VerticalStatsSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Height" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{StaticResource BrushBorder}"/>
            <Setter Property="Opacity" Value="0.45"/>
            <Setter Property="ResizeDirection" Value="Rows"/>
            <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
            <Setter Property="ShowsPreview" Value="True"/>
        </Style>

        <Style x:Key="HorizontalStatsSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Width" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{StaticResource BrushBorder}"/>
            <Setter Property="Opacity" Value="0.45"/>
            <Setter Property="ResizeDirection" Value="Columns"/>
            <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
            <Setter Property="ShowsPreview" Value="True"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="260" MinHeight="320"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="220" MinHeight="300"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="300" MinHeight="180"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="260" MinHeight="500"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="240" MinHeight="400"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource BrushBgPanel}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Stats"
                                   FontSize="22"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Production health overview from currently loaded validation reports"
                                   Margin="0,4,0,0"
                                   Opacity="0.75"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button Content="Refresh Stats"
                                Width="120"
                                Height="32"
                                Margin="0,0,8,0"
                                Command="{Binding RefreshStatsCommand}"/>

                        <Button Content="Export Snapshot"
                                Width="130"
                                Height="32"/>
                    </StackPanel>
                </Grid>
            </Border>

            <stats:UC_StatsKpiStripView Grid.Row="2"
                                        DataContext="{Binding KpiStripVM}"/>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="180"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*" MinWidth="180"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*" MinWidth="180"/>
                </Grid.ColumnDefinitions>

                <stats:UC_IssuesByStageView Grid.Column="0"
                                            DataContext="{Binding IssuesByStageVM}"/>

                <GridSplitter Grid.Column="1"
                              Style="{DynamicResource HorizontalStatsSplitterStyle}"/>

                <stats:UC_DccComparisonView Grid.Column="2"
                                            DataContext="{Binding DccComparisonVM}"/>

                <GridSplitter Grid.Column="3"
                              Style="{DynamicResource HorizontalStatsSplitterStyle}"/>

                <stats:UC_AutoFixPotentialView Grid.Column="4"
                                               DataContext="{Binding AutoFixPotentialVM}"/>
            </Grid>

            <GridSplitter Grid.Row="5"
                          Style="{DynamicResource VerticalStatsSplitterStyle}"/>

            <stats:UC_TopOffendingChecksView Grid.Row="6"
                                             DataContext="{Binding TopOffendingChecksVM}"/>

            <GridSplitter Grid.Row="7"
                          Style="{DynamicResource VerticalStatsSplitterStyle}"/>

            <stats:UC_CriticalFilesRankingView Grid.Row="8"
                                               DataContext="{Binding CriticalFilesRankingVM}"/>

            <GridSplitter Grid.Row="9"
                          Style="{DynamicResource VerticalStatsSplitterStyle}"/>

            <Grid Grid.Row="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="220"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*" MinWidth="220"/>
                </Grid.ColumnDefinitions>

                <stats:UC_TeamHealthView Grid.Column="0"
                                         DataContext="{Binding TeamHealthVM}"/>

                <GridSplitter Grid.Column="1"
                              Style="{DynamicResource HorizontalStatsSplitterStyle}"/>

                <stats:UC_ArtistSupportSummaryView Grid.Column="2"
                                                   DataContext="{Binding ArtistSupportSummaryVM}"/>
            </Grid>

            <GridSplitter Grid.Row="11"
                          Style="{DynamicResource VerticalStatsSplitterStyle}"/>

            <Grid Grid.Row="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="180"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*" MinWidth="180"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*" MinWidth="180"/>
                </Grid.ColumnDefinitions>

                <stats:UC_SeverityMixView Grid.Column="0"
                                          DataContext="{Binding SeverityMixVM}"/>

                <GridSplitter Grid.Column="1"
                              Style="{DynamicResource HorizontalStatsSplitterStyle}"/>

                <stats:UC_FixModeByStageView Grid.Column="2"
                                             DataContext="{Binding FixModeByStageVM}"/>

                <GridSplitter Grid.Column="3"
                              Style="{DynamicResource HorizontalStatsSplitterStyle}"/>

                <stats:UC_PipelineRoiView Grid.Column="4"
                                          DataContext="{Binding PipelineRoiVM}"/>
            </Grid>

        </Grid>
    </ScrollViewer>
</UserControl>